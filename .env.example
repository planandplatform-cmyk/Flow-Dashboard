# Supabase: Project Settings -> API Keys. The publishable key is safe in the browser;
# row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only, never exposed to the browser. Needed to send login invites and to
# show whether someone has signed in yet. Project Settings -> API Keys -> Secret keys.
SUPABASE_SECRET_KEY=sb_secret_...

# The portal's public address, used in invite and sign-in emails.
SITE_URL=https://portal.flowforwardmedia.com

# Anthropic API key for reading analytics screenshots (and the AI commentary
# drafts in Phase 4). Server only. https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Automatic GA4 data (Phase 5). The whole JSON key file of a Google Cloud
# service account, pasted as is (or base64 of it). Server only, read-only access.
# See docs/connect-google-analytics.md.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Protects the nightly sync (/api/cron/sync). Any random string of 16+ characters;
# Vercel Cron sends it automatically.
CRON_SECRET=

# Optional: the client walkthrough video linked in the "Send the report link"
# email (client Settings). Defaults to the current walkthrough.
WALKTHROUGH_VIDEO_URL=
